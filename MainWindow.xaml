<Window x:Class="StudentManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HỆ THỐNG QUẢN LÝ SINH VIÊN - MONGODB (.NET 9 WPF)"
        Height="820" Width="1300"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modern Scrollbar & Card Styles -->
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍃" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="STUDENT MANAGEMENT SYSTEM" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="MongoDB Driver (.NET 9) • qlsinhvien_db.sinhvien" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#14532D" CornerRadius="12" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStatusBadge" Text="MongoDB Connected" FontSize="12" FontWeight="SemiBold" Foreground="#4ADE80"/>
                        </StackPanel>
                    </Border>
                    <Button Content="📥 Nạp Seed Data Mẫu" Height="32" Padding="12,0" Background="#3B82F6" Foreground="White"
                            FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0" Click="BtnSeedData_Click" Cursor="Hand"/>
                    <Button Content="🔄 Tải lại" Height="32" Padding="12,0" Background="#475569" Foreground="White"
                            FontWeight="SemiBold" BorderThickness="0" Click="BtnRefreshAll_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS CONTAINER -->
        <TabControl Grid.Row="1" Background="#F1F5F9" BorderThickness="0" Margin="0" Padding="0">
            
            <!-- ===================== TAB 1: QUẢN LÝ SINH VIÊN ===================== -->
            <TabItem Header="📋 Quản Lý Sinh Viên" FontSize="14" FontWeight="SemiBold" Padding="16,8">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: DANH SÁCH & BỘ LỌC TÌM KIẾM -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header & Count -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Danh sách Sinh viên" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                    <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                        <TextBlock x:Name="TxtTotalGridCount" Text="0 sinh viên" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Search & Filter Bar -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tìm kiếm theo mã SV -->
                                <TextBox x:Name="TxtSearchMaSv" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                                         Padding="8,0" Margin="0,0,6,0" ToolTip="Nhập mã sinh viên (vd: sv001)"/>
                                <Button Grid.Column="1" Content="🔍 Tìm Mã SV" Height="34" Padding="10,0"
                                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                        BorderThickness="0" Margin="0,0,10,0" Click="BtnSearch_Click" Cursor="Hand"/>

                                <!-- Lọc theo lớp -->
                                <ComboBox x:Name="CboFilterClass" Grid.Column="2" Height="34" Margin="0,0,6,0"
                                          SelectionChanged="CboFilterClass_SelectionChanged"/>
                                
                                <!-- Xóa cả lớp (deleteMany) -->
                                <Button Grid.Column="3" Content="🗑️ Xóa Cả Lớp" Height="34" Padding="10,0"
                                        Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                                        BorderThickness="0" ToolTip="Xóa tất cả sinh viên thuộc lớp đang lọc (deleteMany)"
                                        Click="BtnDeleteClass_Click" Cursor="Hand"/>
                            </Grid>

                            <!-- DataGrid Sinh Viên -->
                            <DataGrid x:Name="DgSinhVien" Grid.Row="2" SelectionChanged="DgSinhVien_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSv}" Width="75" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding HoTen}" Width="150"/>
                                    <DataGridTextColumn Header="Tuổi" Binding="{Binding Tuoi}" Width="50"/>
                                    <DataGridTextColumn Header="Phái" Binding="{Binding Phai}" Width="55"/>
                                    <DataGridTextColumn Header="Mã Lớp" Binding="{Binding MaLop}" Width="70"/>
                                    <DataGridTextColumn Header="Ngoại Ngữ" Binding="{Binding NgoaiNguHienThi}" Width="140"/>
                                    <DataGridTextColumn Header="Số Môn" Binding="{Binding SoMonHoc}" Width="65"/>
                                    <DataGridTextColumn Header="Điểm TB" Binding="{Binding DiemTrungBinh}" Width="75" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Xếp Loại" Binding="{Binding XepLoai}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Quick Action Info Hint -->
                            <TextBlock Grid.Row="3" Text="💡 Mẹo: Nhấp chọn 1 sinh viên trong bảng để xem/sửa chi tiết và thao tác mảng động ở khung bên phải."
                                       FontSize="11.5" Foreground="#64748B" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>

                    <!-- RIGHT: FORM NHẬP LIỆU & THAO TÁC MẢNG ĐỘNG -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📝 Thông Tin Sinh Viên &amp; Mảng Động" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                                <!-- Thông tin cố định -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Mã SV & Lớp -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                                        <TextBlock Text="Mã Sinh Viên (*):" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtFormMaSv" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,8">
                                        <TextBlock Text="Mã Lớp (*):" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtFormMaLop" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                                    </StackPanel>

                                    <!-- Họ tên -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                        <TextBlock Text="Họ và Tên (*):" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtFormHoTen" Height="30" VerticalContentAlignment="Center" Padding="6,0"/>
                                    </StackPanel>

                                    <!-- Tuổi & Phái -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Tuổi (>0) (*):" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtFormTuoi" Height="30" VerticalContentAlignment="Center" Padding="6,0" Text="20"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Giới tính:" FontWeight="SemiBold" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RadNam" Content="Nam" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                            <RadioButton x:Name="RadNu" Content="Nữ" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="#E2E8F0" Margin="0,6,0,10"/>

                                <!-- MẢNG NGOẠI NGỮ ĐỘNG -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🌐 Mảng Ngoại Ngữ (ngoaingu):" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="[+] Thêm Ngoại Ngữ ($addToSet)" Height="26" Padding="8,0"
                                                Background="#0284C7" Foreground="White" FontWeight="SemiBold" FontSize="11.5"
                                                BorderThickness="0" Click="BtnAddLanguage_Click" Cursor="Hand" Margin="0,0,6,0"/>
                                        <Button Content="Xóa Ngoại Ngữ" Height="26" Padding="6,0"
                                                Background="#EF4444" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                                BorderThickness="0" Click="BtnRemoveLanguage_Click" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="LstNgoaiNgu" Height="65" BorderBrush="#CBD5E1" Margin="0,0,0,10" SelectionMode="Single"/>

                                <!-- MẢNG MÔN HỌC ĐỘNG -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="📚 Mảng Môn Học &amp; Điểm (monhoc):" FontWeight="Bold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="[+] Thêm Môn ($push)" Height="26" Padding="8,0"
                                                Background="#059669" Foreground="White" FontWeight="SemiBold" FontSize="11.5"
                                                BorderThickness="0" Click="BtnAddSubject_Click" Cursor="Hand" Margin="0,0,6,0"/>
                                        <Button Content="✏️ Sửa Điểm ($)" Height="26" Padding="8,0"
                                                Background="#D97706" Foreground="White" FontWeight="SemiBold" FontSize="11.5"
                                                BorderThickness="0" Click="BtnUpdateGrade_Click" Cursor="Hand" Margin="0,0,6,0"/>
                                        <Button Content="Xóa Môn" Height="26" Padding="6,0"
                                                Background="#EF4444" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                                BorderThickness="0" Click="BtnRemoveSubject_Click" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                                
                                <DataGrid x:Name="DgMonHoc" Height="110" Margin="0,0,0,12" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Môn" Binding="{Binding MaMon}" Width="80" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Tên Môn Học" Binding="{Binding TenMon}" Width="*"/>
                                        <DataGridTextColumn Header="Điểm Số" Binding="{Binding Diem}" Width="70" FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Separator Background="#E2E8F0" Margin="0,0,0,12"/>

                                <!-- CRUD BUTTON ACTIONS -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="➕ Thêm mới (insertOne)" Height="34"
                                            Background="#16A34A" Foreground="White" FontWeight="SemiBold"
                                            BorderThickness="0" Click="BtnInsertOne_Click" Cursor="Hand"/>
                                    <Button Grid.Column="2" Content="💾 Cập nhật ($set)" Height="34"
                                            Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                                            BorderThickness="0" Click="BtnUpdateBasic_Click" Cursor="Hand"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🔄 Thay thế (replaceOne)" Height="34"
                                            Background="#8B5CF6" Foreground="White" FontWeight="SemiBold"
                                            BorderThickness="0" Click="BtnReplaceOne_Click" Cursor="Hand"/>
                                    <Button Grid.Column="2" Content="🗑️ Xóa SV (deleteOne)" Height="34"
                                            Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                                            BorderThickness="0" Click="BtnDeleteOne_Click" Cursor="Hand"/>
                                </Grid>

                                <Button Content="🧹 Xóa trắng Form (Nhập mới)" Height="30" Background="#F1F5F9"
                                        Foreground="#475569" FontWeight="SemiBold" BorderBrush="#CBD5E1"
                                        BorderThickness="1" Click="BtnClearForm_Click" Cursor="Hand"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== TAB 2: DASHBOARD & THỐNG KÊ ===================== -->
            <TabItem Header="📊 Dashboard &amp; Báo Cáo Thống Kê" FontSize="14" FontWeight="SemiBold" Padding="16,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Refresh Dashboard -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊 Báo Cáo &amp; Thống Kê (MongoDB Aggregation Framework)" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                            <Button Content="🔄 Làm mới Dashboard" HorizontalAlignment="Right" Height="32" Padding="14,0"
                                    Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                                    Click="BtnRefreshDashboard_Click" Cursor="Hand"/>
                        </Grid>

                        <!-- 1. KPI CARDS -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Tổng sinh viên -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="👥 TỔNG SINH VIÊN" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtKpiTotalStudents" Text="0" FontSize="26" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,2"/>
                                    <TextBlock Text="sinh viên đang quản lý" FontSize="11.5" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Tổng số lớp -->
                            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="🏫 TỔNG SỐ LỚP HỌC" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtKpiTotalClasses" Text="0" FontSize="26" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,2"/>
                                    <TextBlock Text="lớp học khác nhau" FontSize="11.5" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: GPA Toàn trường -->
                            <Border Grid.Column="4" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="🎯 GPA TOÀN TRƯỜNG" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtKpiSchoolGpa" Text="0.0" FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,2"/>
                                    <TextBlock Text="trung bình tất cả môn học" FontSize="11.5" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Tỷ lệ Nam / Nữ -->
                            <Border Grid.Column="6" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="🚻 TỶ LỆ GIỚI TÍNH" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtKpiGenderRatio" Text="0% / 0%" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,8,0,2"/>
                                    <TextBlock x:Name="TxtKpiGenderDetail" Text="Nam: 0 | Nữ: 0" FontSize="11.5" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2. THỐNG KÊ THEO LỚP & ĐỘ PHỔ BIẾN NGOẠI NGỮ -->
                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thống kê theo lớp -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="🏫 Thống Kê Theo Lớp ($group)" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="DgClassStats" Height="180" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã Lớp" Binding="{Binding MaLop}" Width="100" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Sĩ Số" Binding="{Binding SiSo}" Width="80"/>
                                            <DataGridTextColumn Header="Điểm TB Cao Nhất" Binding="{Binding DiemTbCaoNhat}" Width="140" FontWeight="SemiBold"/>
                                            <DataGridTextColumn Header="Điểm TB Thấp Nhất" Binding="{Binding DiemTbThapNhat}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Thống kê độ phổ biến ngoại ngữ -->
                            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="🌐 Độ Phổ Biến Ngoại Ngữ ($unwind + $group)" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="DgLangStats" Height="180" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ngoại Ngữ" Binding="{Binding NgoaiNgu}" Width="150" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Số Lượng SV" Binding="{Binding SoLuongSinhVien}" Width="110"/>
                                            <DataGridTextColumn Header="Tỷ Lệ (%)" Binding="{Binding TyLePhanTram, StringFormat={}{0}%}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 3. TOP 5 SINH VIÊN & PHÂN LOẠI HỌC LỰC -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bảng xếp hạng Top 5 -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="🏆 Bảng Xếp Hạng Top 5 Sinh Viên ($sort, $limit)" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="DgTop5Students" Height="190" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Hạng" Binding="{Binding Hang}" Width="50" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSv}" Width="75" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Họ và Tên" Binding="{Binding HoTen}" Width="150"/>
                                            <DataGridTextColumn Header="Lớp" Binding="{Binding MaLop}" Width="70"/>
                                            <DataGridTextColumn Header="Điểm TB" Binding="{Binding DiemTrungBinh}" Width="75" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Xếp Loại" Binding="{Binding XepLoai}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Phân loại học lực toàn trường -->
                            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="📈 Phân Loại Học Lực Toàn Trường" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                    
                                    <ItemsControl x:Name="IcAcademicClass">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Loai}" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155"/>
                                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#64748B">
                                                            <Run Text="{Binding SoLuong}" FontWeight="Bold"/> <Run Text="SV ("/><Run Text="{Binding TyLePhanTram}"/><Run Text="%)"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1" Height="10" Value="{Binding TyLePhanTram}" Maximum="100"
                                                                 Foreground="{Binding MauSac}" Background="#E2E8F0" BorderThickness="0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#1E293B" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusBar" Text="Sẵn sàng." FontSize="12" Foreground="#94A3B8"/>
                <TextBlock Text="Hệ thống Quản lý Sinh viên MongoDB • Tiêu chuẩn 10/10" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
