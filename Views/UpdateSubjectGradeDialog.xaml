<Window x:Class="StudentManagementApp.Views.UpdateSubjectGradeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập Nhật Điểm Môn Học (Positional Operator $)"
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="✏️ Cập Nhật Điểm Môn Học" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="Sử dụng toán tử vị trí (Positional Operator $) để cập nhật điểm chính xác" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2">
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="TxtStudentInfo" Text="Sinh viên: ..." FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSubjectInfo" Text="Môn học: ..." Foreground="#1E3A8A"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Điểm số mới (0.0 - 10.0) (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtNewDiem" Height="36" VerticalContentAlignment="Center" Padding="8,0" FontSize="15" FontWeight="Bold" Foreground="#2563EB"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Height="32" Background="#E2E8F0" Foreground="#334155"
                    BorderThickness="0" Margin="0,0,10,0" Click="BtnCancel_Click" Cursor="Hand"/>
            <Button Content="Lưu Điểm Mới ($)" Width="150" Height="32" Background="#2563EB" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Click="BtnOk_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
