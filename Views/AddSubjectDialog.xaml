<Window x:Class="StudentManagementApp.Views.AddSubjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Môn Học Mới ($push)"
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📚 Thêm Môn Học Mới" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="Nhập bộ 3 thông tin: Mã môn, Tên môn và Điểm số (0.0 - 10.0)" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Mã môn học (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtMaMon" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

            <TextBlock Text="Tên môn học (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtTenMon" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>

            <TextBlock Text="Điểm số (Thang điểm 0.0 - 10.0) (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDiem" Height="34" VerticalContentAlignment="Center" Padding="8,0" Text="8.0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Height="32" Background="#E2E8F0" Foreground="#334155"
                    BorderThickness="0" Margin="0,0,10,0" Click="BtnCancel_Click" Cursor="Hand"/>
            <Button Content="Thêm vào CSDL ($push)" Width="170" Height="32" Background="#10B981" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Click="BtnOk_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
